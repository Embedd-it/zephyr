#include <mem.h>
#include <arm/armv7-m.dtsi>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-m7";
			reg = <0>;
			device_type = "cpu";
			#address-cells = <1>;
			#size-cells = <1>;

			mpu: mpu@e000ed90 {
				compatible = "arm,armv7m-mpu";
				reg = <0xe000ed90 0x40>;
			};
		};
	};

	soc {
		flash0: flash@400000 {};

		sram0: memory@20400000 {
			compatible = "mmio-sram";
		};

		pinctrl: pinctrl@400e0e00 {
			compatible = "microchip,pio-g1-pinctrl";
			ranges = <0x400e0e00 0x400e0e00 0xa00>;
			#address-cells = <1>;
			#size-cells = <1>;

			pioa: gpio@400e0e00 {
				compatible = "microchip,pio-g1-gpio";
				reg = <0x400e0e00 0x168>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			piob: gpio@400e1000 {
				compatible = "microchip,pio-g1-gpio";
				reg = <0x400e1000 0x168>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			pioc: gpio@400e1200 {
				compatible = "microchip,pio-g1-gpio";
				reg = <0x400e1200 0x168>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			piod: gpio@400e1400 {
				compatible = "microchip,pio-g1-gpio";
				reg = <0x400e1400 0x168>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			pioe: gpio@400e1600 {
				compatible = "microchip,pio-g1-gpio";
				reg = <0x400e1600 0x168>;
				gpio-controller;
				#gpio-cells = <2>;
			};
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};
