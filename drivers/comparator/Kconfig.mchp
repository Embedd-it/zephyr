config COMPARATOR_MCHP_AC_G1
	bool "Microchip Comparator Driver for AC G1 Peripherals"
	default y
	depends on DT_HAS_MICROCHIP_AC_G1_COMPARATOR_ENABLED
	select PINCTRL
	help
	  Enable support for the Microchip Comparator driver
	  on G1 AC peripherals.

config COMPARATOR_MCHP_ACC_G1
	bool "Microchip Comparator Driver for ACC G1 Peripherals"
	default y
	depends on DT_HAS_MICROCHIP_ACC_G1_COMPARATOR_ENABLED
	select PINCTRL
	help
	  Enable support for the Microchip Comparator driver
	  on G1 ACC peripherals.
