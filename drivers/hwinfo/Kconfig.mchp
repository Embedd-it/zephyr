config HWINFO_MCHP_G1
	bool "Microchip hwinfo"
	default y
	depends on DT_HAS_MICROCHIP_HWINFO_G1_ENABLED || \
		   DT_HAS_MICROCHIP_RSTC_G1_RESET_ENABLED
	select HWINFO_HAS_DRIVER
	help
	  Enable mchp hwinfo driver

config HWINFO_MCHP_CHIPID_G1
	bool "Microchip CHIPID g1 hwinfo"
	default y
	depends on DT_HAS_MICROCHIP_CHIPID_G1_HWINFO_ENABLED || \
			DT_HAS_MICROCHIP_RSTC_G2_RESET_ENABLED
	select HWINFO_HAS_DRIVER
	help
	  Enable Microchip CHIPID g1 hwinfo driver
