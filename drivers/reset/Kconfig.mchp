config RESET_MCHP_RSTC_G1
	bool "Microchip RSTC G1 reset driver"
	default y
	depends on DT_HAS_MICROCHIP_RSTC_G1_RESET_ENABLED
	help
	  Enable RESET driver for Microchip G1.

config RESET_MCHP_RSTC_G2
	bool "Microchip RSTC G2 reset driver"
	default y
	depends on DT_HAS_MICROCHIP_RSTC_G2_RESET_ENABLED
	help
	  Enable RESET driver for Microchip G2.
