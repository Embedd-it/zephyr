config UDC_MCHP_UDPHS_G1
	bool "Microchip USB Device High Speed Port (UDPHS) G1"
	default y
	depends on DT_HAS_MICROCHIP_UDPHS_G1_UDC_ENABLED
	select PINCTRL
	select GPIO
	select SYS_MEM_BLOCKS
	select EVENTS
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT
	help
	  Enable the Microchip UDPHS G1 driver.

if UDC_MCHP_UDPHS_G1

config UDC_MCHP_UDPHS_G1_STACK_SIZE
	int "UDC controller driver internal thread stack size"
	default 1024
	help
	  Device controller driver internal thread stack size.

config UDC_MCHP_UDPHS_G1_THREAD_PRI
	int "UDC controller driver thread priority"
	default 8
	help
	  Device controller driver thread priority.

config UDC_MCHP_UDPHS_G1_DMA
	bool "DMA support"
	default y
	help
	  Enable DMA transfer, otherwise data will be transferred via FIFO.

config UDC_MCHP_UDPHS_G1_BURST_LOCK
	bool "Lock bus access for maximum bandwidth"
	help
	  USB packets system data bursts will be locked for
	  maximum optimization of the bus bandwidth usage.

endif # UDC_MCHP_UDPHS_G1

DT_UDC_MCHP_USBHS_G2_HAS_HIGH_SPEED := $(dt_compat_any_has_prop,$(DT_COMPAT_MICROCHIP_USBHS_G2_UDC),maximum-speed,high-speed)

config UDC_MCHP_USBHS_G2
	bool "PIC32CZ CA70 USBHS USB Device Controller driver"
	default y
	depends on DT_HAS_MICROCHIP_USBHS_G2_UDC_ENABLED && !SOC_PIC32CZ2051CA70064
	select EVENTS
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT if $(DT_UDC_MCHP_USBHS_G2_HAS_HIGH_SPEED)
	help
	  PIC32CZ CA70 family USBHS device controller driver.

	  The driver support High-Speed (480 Mbps) and Full-Speed (12 Mbps)
	  operation. The peripheral does not work on the 64-pin TFQ package devices
	  (see the PIC32CZ CA70/MC70 Family Silicon Errata and Data Sheet
	   Clarifications, section 2.3)

if UDC_MCHP_USBHS_G2

config UDC_MCHP_USBHS_G2_STACK_SIZE
	int "UDC controller driver internal thread stack size"
	default 512
	help
	  Device controller driver internal thread stack size.

config UDC_MCHP_USBHS_G2_THREAD_PRIORITY
	int "UDC controller driver thread priority"
	default 8
	help
	  Device controller driver thread priority.

config UDC_MCHP_USBHS_G2_DMA
	bool "Hardware DMA for data endpoints"
	default y
	help
	  Use the USBHS peripheral's built-in DMA channels to move IN/OUT
	  data instead of the CPU byte-copy loop. The peripheral has 7 DMA
	  channels hard-wired one-to-one to hardware endpoints 1..7; EP0 and
	  any configured endpoint beyond hardware endpoint 7 always use the
	  CPU-copy path regardless of this option.

endif # UDC_MCHP_USBHS_G2
