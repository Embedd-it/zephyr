/* SPI driven CS */
&spi0 {
	clock-frequency = <12000000>;
	/delete-property/ cs-gpios;
	pinctrl-0 = <&ext1_header_spi>;
	status = "okay";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <16000000>;
	};
};
