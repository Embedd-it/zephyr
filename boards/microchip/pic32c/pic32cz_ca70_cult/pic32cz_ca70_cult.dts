/dts-v1/;
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <microchip/pic32c/pic32cz_ca70_mc70/pic32cz_ca70/pic32cz2051ca70144.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include "pic32cz_ca70_cult-pinctrl.dtsi"

/ {
	compatible = "pic32cz_ca70,cult", "microchip,pic32cz2051ca70144";
	model = "PIC32CZ CA70 Curiosity Ultra";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};

	aliases {
		led0 = &led0;
		eeprom-0 = &eeprom0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&piod 29 GPIO_ACTIVE_LOW>;
			label = "User LED 1";
		};
	};
};

&twihs0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&mikrobus_header_i2c>;
	pinctrl-names = "default";
	dmas = <&xdmac 6 DMA_PERID_TWIHS0_TX>, <&xdmac 7 DMA_PERID_TWIHS0_RX>;
	dma-names = "tx", "rx";
	status = "okay";

	eeprom0: eeprom@56 {
		compatible = "atmel,at24", "atmel,24mac402";
		reg = <0x56>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
	};

	eeprom_mac: eeprom@5e {
		compatible = "atmel,at24", "atmel,24mac402";
		reg = <0x5e>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
		read-only;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			mac_address: mac-address@9a {
				reg = <0x9a 6>;
				#nvmem-cell-cells = <0>;
			};
		};
	};
};

&gmac {
	pinctrl-names = "default";
	pinctrl-0 = <&ethernet_header_rmii>;
	nvmem-cells = <&mac_address>;
	nvmem-cell-names = "mac-address";
	phy-connection-type = "rmii";
	phy-handle = <&gmac_phy>;
	status = "okay";
};

&gmac_mdio {
	pinctrl-names = "default";
	pinctrl-0 = <&ethernet_header_mdio>;
	status = "okay";

	gmac_phy: gmac0_phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		reset-gpios = <&pioc 10 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&uart1 {
	current-speed = <115200>;

	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";

	status = "okay";
};

&xdmac {
	status = "okay";
};

&cpu0 {
	clock-frequency = <300000000>;
};
