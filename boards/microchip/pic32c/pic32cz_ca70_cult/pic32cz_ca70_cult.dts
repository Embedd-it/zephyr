/dts-v1/;
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <microchip/pic32c/pic32cz_ca70_mc70/pic32cz_ca70/pic32cz2051ca70144.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "pic32cz_ca70_cult-pinctrl.dtsi"

/ {
	compatible = "pic32cz_ca70,cult", "microchip,pic32cz2051ca70144";
	model = "PIC32CZ CA70 Curiosity Ultra";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};

	aliases {
		led0 = &led0;
		pwm-led0 = &green_pwm_led;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&piod 29 GPIO_ACTIVE_LOW>;
			label = "User LED 1";
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";

		green_pwm_led: green_pwm_led {
			pwms = <&pwm0 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};
};

&uart1 {
	current-speed = <115200>;

	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";

	status = "okay";
};

&xdmac {
	status = "okay";
};

&cpu0 {
	clock-frequency = <300000000>;
};
